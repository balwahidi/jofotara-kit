{
  "name": "jofotara-kit",
  "version": "0.2.0",
  "description": "Document builder, XML validator, local mock server and AI agent skill for JoFotara (Jordan ISTD e-invoicing) integrations.",
  "type": "module",
  "bin": {
    "jofotara-kit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "jofotara",
    "fawtara",
    "jordan",
    "istd",
    "e-invoicing",
    "ubl",
    "invoice",
    "validator",
    "mock-server",
    "agent-skill",
    "builder",
    "ubl-generator"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balwahidi/jofotara-kit.git"
  },
  "homepage": "https://github.com/balwahidi/jofotara-kit#readme",
  "bugs": {
    "url": "https://github.com/balwahidi/jofotara-kit/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xmldom/xmldom": "0.9.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "6.0.3"
  }
}
